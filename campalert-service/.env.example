# Copy this to .env and fill in real values. .env is gitignored at the repo
# root (patterns `.env` / `.env.*` / `!.env.example` apply repo-wide), so
# this file is the only one that should ever be committed.

NODE_ENV=development
PORT=3001

# --- MySQL (docker-compose service name is "mysql") ---
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=campalert
MYSQL_USER=campalert
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- Redis (docker-compose service name is "redis") — BullMQ job queue ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- SendGrid ---
# Self-contained to this service on purpose — kept independent of the
# existing Python backend's own SENDGRID_* vars in backend/.env.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# --- Parks Canada polling tuning ---
# How often availabilityPoller runs (node-cron expression).
AVAILABILITY_POLL_CRON=*/5 * * * *
# Max random jitter (seconds) added before each poll run, so a fleet of
# workers/restarts doesn't hammer reservation.pc.gc.ca in lockstep.
AVAILABILITY_POLL_JITTER_SECONDS=60
# How often catalogSync runs (node-cron expression) — daily by default.
CATALOG_SYNC_CRON=0 6 * * *
