# Postgres connection used by the API, Alembic and the catalogue CLI (server-side only).
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres

# Supabase project URL; access tokens are verified against its published signing keys.
SUPABASE_URL=https://<project-ref>.supabase.co

# Optional: only for projects still signing tokens with the legacy HS256 secret
# (and the local Supabase CLI stack). Never needed for asymmetric signing keys.
# SUPABASE_JWT_SECRET=

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Campground alert emails: sendgrid (production), mailpit (local Supabase mail
# catcher at MAILPIT_URL), or console (print only; the default).
EMAIL_BACKEND=console
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=
# MAILPIT_URL=http://127.0.0.1:44324
# Base URL used for links in alert emails.
APP_URL=http://localhost:3000

# Parks Canada availability: response cache, and the global cap on live
# requests per minute (shared by the API and the alert poller).
# AVAILABILITY_CACHE_MINUTES=5
# AVAILABILITY_REQUESTS_PER_MINUTE=20
# Alert poller (scripts/poll_alerts.py): runs closer together than this are
# skipped, and each run makes at most this many requests.
# ALERT_POLL_MIN_INTERVAL_MINUTES=10
# ALERT_POLL_MAX_REQUESTS=20
